# Copy to .env and adjust before running `docker compose up -d`.

# Postgres backend store (experiment/run metadata)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# Port the MLflow UI/API is exposed on (host side)
MLFLOW_PORT=5000

# Host paths backing the Postgres data and MLflow artifacts volumes.
# Point these at durable/shared storage if you want the server to be
# rebuildable on another host without losing history.
POSTGRES_DATA_HOST=./data/postgres
MLFLOW_ARTIFACT_ROOT_HOST=./data/artifacts
